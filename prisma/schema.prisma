generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  clerkId          String?        @unique
  email            String         @unique
  name             String?
  role             String         @default("CONSUMER")
  plan             String         @default("FREE")
  stripeCustomerId String?
  stripeSubId      String?
  diagnosesUsed    Int            @default(0)
  diagnosesResetAt DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  diagnoses        Diagnosis[]
  orders           Order[]
  savedMachines    SavedMachine[]
  apiKeys          ApiKey[]
  customers        Customer[]     @relation("CustomerOwner")
  workOrders       WorkOrder[]    @relation("WorkOrderOwner")
  referrals        Referral[]     @relation("ReferralReferrer")
  referralCode     String?        @unique

  @@index([role])
  @@index([plan])
}

model WashingMachine {
  id           String         @id @default(cuid())
  brand        String
  model        String
  yearFrom     Int?
  yearTo       Int?
  imageUrl     String?
  description  String?
  errorCodes   ErrorCode[]
  repairGuides RepairGuide[]
  parts        PartMachine[]
  saved        SavedMachine[]

  @@unique([brand, model])
  @@index([brand])
}

model SavedMachine {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineId String
  machine   WashingMachine @relation(fields: [machineId], references: [id])
  nickname  String?
  createdAt DateTime       @default(now())

  @@unique([userId, machineId])
}

model ErrorCode {
  id           String            @id @default(cuid())
  code         String
  machineId    String
  machine      WashingMachine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title        String
  description  String
  likelyCauses String
  severity     String            @default("MEDIUM")
  diyFriendly  Boolean           @default(true)
  parts        ErrorCodeParts[]
  guides       ErrorCodeGuides[]

  @@unique([code, machineId])
  @@index([code])
  @@index([machineId])
  @@index([severity])
}

model RepairGuide {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  machineId   String?
  machine     WashingMachine?   @relation(fields: [machineId], references: [id])
  difficulty  String            @default("MEDIUM")
  timeMinutes Int
  steps       String
  tools       String
  summary     String
  warnings    String?
  isPremium   Boolean           @default(false)
  views       Int               @default(0)
  errorCodes  ErrorCodeGuides[]
  parts       GuideParts[]
  createdAt   DateTime          @default(now())

  @@index([machineId])
  @@index([difficulty])
  @@index([isPremium])
}

model Part {
  id          String           @id @default(cuid())
  sku         String           @unique
  name        String
  description String?
  brand       String
  category    String           @default("OTHER")
  priceEur    Float
  /// Wholesale/purchase price excluding VAT. Null = unknown, margin unreported.
  costEur     Float?
  stock       Int              @default(0)
  imageUrl    String?
  isOriginal  Boolean          @default(true)
  supplier    String?
  machines    PartMachine[]
  errorCodes  ErrorCodeParts[]
  guides      GuideParts[]
  orderItems  OrderItem[]

  @@index([brand])
  @@index([category])
  @@index([stock])
}

model PartMachine {
  partId    String
  part      Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  machineId String
  machine   WashingMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([partId, machineId])
}

model ErrorCodeParts {
  errorCodeId String
  errorCode   ErrorCode @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([errorCodeId, partId])
}

model ErrorCodeGuides {
  errorCodeId String
  errorCode   ErrorCode   @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  guideId     String
  guide       RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([errorCodeId, guideId])
}

model GuideParts {
  guideId String
  guide   RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  partId  String
  part    Part        @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([guideId, partId])
}

model Diagnosis {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  brand     String
  model     String?
  symptoms  String
  messages  String
  result    String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  status          String      @default("PENDING")
  subtotalEur     Float
  discountEur     Float       @default(0)
  shippingEur     Float       @default(0)
  totalEur        Float
  /// VAT rate applied to this order (0.21 = 21%).
  vatRate         Float       @default(0.21)
  /// VAT contained in totalEur. Catalog prices are VAT-inclusive.
  vatEur          Float       @default(0)
  /// Buyer's VAT number when they ordered as a business.
  vatNumber       String?
  /// Sum of costEur * quantity at time of order; null when any cost is unknown.
  costEur         Float?
  stripePaymentId String?
  shippingAddress String
  email           String
  invoice         Invoice?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([stripePaymentId])
}

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([type])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String
  part      Part   @relation(fields: [partId], references: [id])
  quantity  Int
  unitPrice Float
}

// ─── B2B API keys ────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  scopes     String    @default("read:parts,read:errorcodes,read:guides")
  rateLimit  Int       @default(1000)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── Reviews (moderated) ─────────────────────────────────────────
model Review {
  id         String   @id @default(cuid())
  targetType String // "part" | "guide"
  targetSku  String?
  targetSlug String?
  rating     Int
  title      String
  body       String
  author     String
  email      String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now())

  @@index([targetType, targetSku])
  @@index([targetType, targetSlug])
  @@index([status])
}

// ─── Returns (RMA) ───────────────────────────────────────────────
model RmaRequest {
  id        String   @id @default(cuid())
  rmaNumber String   @unique
  orderId   String
  name      String
  email     String
  reason    String
  notes     String
  status    String   @default("RECEIVED") // RECEIVED | APPROVED | REJECTED | REFUNDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

// ─── Monteur Pro applications ────────────────────────────────────
model MonteurApplication {
  id              String   @id @default(cuid())
  applicationId   String   @unique
  companyName     String
  kvkNumber       String
  vatNumber       String?
  email           String
  phone           String?
  contactName     String
  yearsExperience Int?
  coverageAreas   String?
  specializations String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([status])
}

// ─── Newsletter / lead magnets ───────────────────────────────────
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// ─── AI quality loop ─────────────────────────────────────────────
model DiagnosisFeedback {
  id          String   @id @default(cuid())
  diagnosisId String?
  sessionId   String?
  rating      String // "up" | "down"
  comment     String?
  createdAt   DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
}

// ─── Monteur CRM: klanten en werkorders ──────────────────────────
model Customer {
  id         String      @id @default(cuid())
  ownerId    String
  owner      User        @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  street     String?
  postalCode String?
  city       String?
  machine    String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workOrders WorkOrder[]

  @@index([ownerId])
  @@index([ownerId, name])
}

model WorkOrder {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation("WorkOrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reference   String
  machine     String?
  errorCode   String?
  problem     String
  status      String    @default("OPEN") // OPEN | GEPLAND | WACHT_OP_ONDERDEEL | VOLTOOID | GEANNULEERD
  urgent      Boolean   @default(false)
  scheduledAt DateTime?
  priceEur    Float?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownerId, reference])
  @@index([ownerId, status])
  @@index([customerId])
}

// ─── Referrals ───────────────────────────────────────────────────
model Referral {
  id          String    @id @default(cuid())
  code        String
  referrerId  String?
  referrer    User?     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  visitorId   String
  landingPath String?
  signedUpAt  DateTime?
  convertedAt DateTime?
  rewardEur   Float     @default(0)
  createdAt   DateTime  @default(now())

  @@unique([code, visitorId])
  @@index([code])
  @@index([referrerId])
}

// ─── Invoices ────────────────────────────────────────────────────
// NL law requires a sequential, gapless invoice number and a VAT
// specification per order, retained for 7 years. Seller and buyer details are
// snapshotted so a later change of address never rewrites history.
model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  year        Int
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  issuedAt    DateTime @default(now())
  subtotalEur Float
  discountEur Float    @default(0)
  shippingEur Float    @default(0)
  vatRate     Float
  vatEur      Float
  totalEur    Float
  sellerJson  String
  buyerJson   String
  linesJson   String

  @@index([year])
  @@index([issuedAt])
}

// Allocates gapless invoice numbers per year under a transaction.
model InvoiceSequence {
  year Int @id
  last Int @default(0)
}

// ─── Metered free usage ──────────────────────────────────────────
// Enforces the free tier for visitors who are not signed in, so the paid
// plans mean something. Keyed on a hash of the visitor cookie or IP.
model UsageCounter {
  id        String   @id @default(cuid())
  scope     String
  key       String
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([windowEnd])
}
