generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  clerkId          String?        @unique
  email            String         @unique
  name             String?
  role             String         @default("CONSUMER")
  plan             String         @default("FREE")
  stripeCustomerId String?
  stripeSubId      String?
  diagnosesUsed    Int            @default(0)
  diagnosesResetAt DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  diagnoses        Diagnosis[]
  orders           Order[]
  savedMachines    SavedMachine[]
  memberships      Membership[]
  assignedOrders   WorkOrder[]    @relation("WorkOrderTechnician")

  @@index([role])
  @@index([plan])
}

// ─── Monteur SaaS: multi-tenant foundation ──────────────────────────────
// A Company is a repair business (solo technician or team). Every monteur
// user belongs to a Company via a Membership, and all CRM/work-order data
// is scoped to a companyId to keep tenants isolated from each other.
model Company {
  id          String       @id @default(cuid())
  name        String
  kvkNumber   String?
  vatNumber   String?
  email       String?
  phone       String?
  addressLine String?
  postalCode  String?
  city        String?
  plan        String       @default("MONTEUR_SOLO")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  customers   Customer[]
  workOrders  WorkOrder[]

  @@index([plan])
}

// Links a User to a Company with a role scoped to that company (distinct
// from User.role, which is the platform-wide role used for admin access).
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String   @default("OWNER") // OWNER | ADMIN | TECHNICIAN
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

// A monteur's customer — distinct from the consumer-facing User account.
// A customer does not need a WasFix login.
model Customer {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  addressLine String?
  postalCode  String?
  city        String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  machines    CustomerMachine[]
  workOrders  WorkOrder[]

  @@index([companyId])
}

// A physical appliance owned by a customer — distinct from the catalog
// WashingMachine model above, which describes a make/model in general.
model CustomerMachine {
  id            String      @id @default(cuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand         String
  model         String
  serialNumber  String?
  purchaseDate  DateTime?
  warrantyUntil DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  workOrders    WorkOrder[]

  @@index([customerId])
}

// Status flow: NEW -> PRE_DIAGNOSIS -> SCHEDULED -> ON_THE_WAY ->
// IN_PROGRESS -> WAITING_FOR_PART -> COMPLETED -> INVOICED -> PAID ->
// WARRANTY, with CANCELLED reachable from any non-terminal state.
model WorkOrder {
  id             String           @id @default(cuid())
  number         String           @unique
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id])
  machineId      String?
  machine        CustomerMachine? @relation(fields: [machineId], references: [id])
  technicianId   String?
  technician     User?            @relation("WorkOrderTechnician", fields: [technicianId], references: [id])
  complaint      String
  aiDiagnosis    String?
  technicianNote String?
  status         String           @default("NEW")
  scheduledAt    DateTime?
  calloutFeeEur  Float            @default(0)
  laborHours     Float?
  signatureUrl   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          WorkOrderItem[]

  @@index([companyId])
  @@index([customerId])
  @@index([technicianId])
  @@index([status])
  @@index([createdAt])
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String?
  part        Part?     @relation(fields: [partId], references: [id])
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)

  @@index([workOrderId])
  @@index([partId])
}

model WashingMachine {
  id           String         @id @default(cuid())
  brand        String
  model        String
  yearFrom     Int?
  yearTo       Int?
  imageUrl     String?
  description  String?
  errorCodes   ErrorCode[]
  repairGuides RepairGuide[]
  parts        PartMachine[]
  saved        SavedMachine[]

  @@unique([brand, model])
  @@index([brand])
}

model SavedMachine {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineId String
  machine   WashingMachine @relation(fields: [machineId], references: [id])
  nickname  String?
  createdAt DateTime       @default(now())

  @@unique([userId, machineId])
}

model ErrorCode {
  id           String            @id @default(cuid())
  code         String
  machineId    String
  machine      WashingMachine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title        String
  description  String
  likelyCauses String
  severity     String            @default("MEDIUM")
  diyFriendly  Boolean           @default(true)
  parts        ErrorCodeParts[]
  guides       ErrorCodeGuides[]

  @@unique([code, machineId])
  @@index([code])
  @@index([machineId])
  @@index([severity])
}

model RepairGuide {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  machineId   String?
  machine     WashingMachine?   @relation(fields: [machineId], references: [id])
  difficulty  String            @default("MEDIUM")
  timeMinutes Int
  steps       String
  tools       String
  summary     String
  warnings    String?
  isPremium   Boolean           @default(false)
  views       Int               @default(0)
  errorCodes  ErrorCodeGuides[]
  parts       GuideParts[]
  createdAt   DateTime          @default(now())

  @@index([machineId])
  @@index([difficulty])
  @@index([isPremium])
}

model Part {
  id             String           @id @default(cuid())
  sku            String           @unique
  name           String
  description    String?
  brand          String
  category       String           @default("OTHER")
  priceEur       Float
  stock          Int              @default(0)
  imageUrl       String?
  isOriginal     Boolean          @default(true)
  supplier       String?
  machines       PartMachine[]
  errorCodes     ErrorCodeParts[]
  guides         GuideParts[]
  orderItems     OrderItem[]
  workOrderItems WorkOrderItem[]

  @@index([brand])
  @@index([category])
  @@index([stock])
}

model PartMachine {
  partId    String
  part      Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  machineId String
  machine   WashingMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([partId, machineId])
}

model ErrorCodeParts {
  errorCodeId String
  errorCode   ErrorCode @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([errorCodeId, partId])
}

model ErrorCodeGuides {
  errorCodeId String
  errorCode   ErrorCode   @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  guideId     String
  guide       RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([errorCodeId, guideId])
}

model GuideParts {
  guideId String
  guide   RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  partId  String
  part    Part        @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([guideId, partId])
}

model Diagnosis {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  brand     String
  model     String?
  symptoms  String
  messages  String
  result    String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  status          String      @default("PENDING")
  subtotalEur     Float
  discountEur     Float       @default(0)
  shippingEur     Float       @default(0)
  totalEur        Float
  stripePaymentId String?
  shippingAddress String
  email           String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([stripePaymentId])
}

model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())

  @@index([type])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String
  part      Part   @relation(fields: [partId], references: [id])
  quantity  Int
  unitPrice Float
}
