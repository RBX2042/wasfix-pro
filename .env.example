# ═══════════════════════════════════════════════════════════════════════
# WasFix Pro: environment variables
#
# Copy to .env.local for local work. On the host (Vercel) set them in
# Settings > Environment Variables, scope PRODUCTION only unless a line
# says otherwise. `npm run preflight` checks them against the code.
#
# Rules that bite:
#  - Every NEXT_PUBLIC_* value (and the Clerk keys) is used at BUILD time (client code,
#    the CSP, CORS and redirects in next.config.ts); some server code also reads
#    NEXT_PUBLIC_APP_URL at run time. Keep the same value set for the build and the
#    run, and redeploy after changing one: a restart alone is not enough.
#  - Do NOT put DEMO_MODE=true or NODE_ENV=... into a deployment. Demo mode
#    exists only outside production; it makes every visitor the admin.
#  - Preview deployments must use their OWN database and Stripe TEST keys,
#    never the production ones. Set variables for Preview separately.
#  - tests/QA helper variables (QA_*, PROBE_*) are not listed here.
# ═══════════════════════════════════════════════════════════════════════


# ─── Local development only ────────────────────────────────────────────
# Outside production, with no Clerk keys set, every visitor is the seeded demo
# admin automatically. Set this to force that even when Clerk keys ARE present.
# Never set it on a deployment: it is ignored in production (always off) and the
# preflight flags it.
# DEMO_MODE=true
# `npm run db:seed` fills a LOCAL database with demo accounts and demo stock. On a
# database that is not on this machine (or with NODE_ENV=production) it seeds the
# catalogue only, with stock 0 and no users. SEED_DEMO=true forces demo mode on a
# remote database: only ever for a throwaway one.
# SEED_DEMO=true
# Local production-mode runs (`next build` + `next start`): use fictional
# COMPANY_* values (see the company block) and NEXT_PUBLIC_APP_URL below.
# Unsigned Clerk webhooks, local development only (ignored in production).
# CLERK_WEBHOOK_ALLOW_UNSIGNED=true


# ─── Core: REQUIRED in production ──────────────────────────────────────
# The public address, domain only, https, no path, no trailing slash. Used for
# Stripe return URLs, every e-mail button, canonical URLs, sitemap, robots.txt.
# A Vercel production build REFUSES to build without a usable value; elsewhere
# checkout answers 503 and the sitemap stays empty until it is set.
# Decide www vs apex ONCE: the other one is redirected to this host.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─── Database (Postgres, Supabase) ─────────────────────────────────────
# REQUIRED in production. Without it the shop cannot take orders.
# Runtime URL = Supabase TRANSACTION pooler, port 6543:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# (URL-encode special characters in the password.)
# Local: docker run -d -e POSTGRES_PASSWORD=wasfix -e POSTGRES_DB=wasfix -p 5432:5432 postgres:16
#        DATABASE_URL=postgresql://postgres:wasfix@localhost:5432/wasfix
DATABASE_URL=
# Direct or session-pooler connection (port 5432). ONLY for migrations and the
# seed: `npm run db:migrate:deploy`, `npm run db:seed`, scripts/make-admin.ts.
# The transaction pooler cannot run migrations. The running site does not use
# it, but set it in Vercel's PRODUCTION environment as well: the deploy workflow
# (.github/workflows/deploy.yml, scripts/deploy/migrate.sh) pulls the Production
# variables and runs the migrations from the GitHub runner with it, before the
# new build goes live. Use the SESSION pooler there, not the direct host
# db.<ref>.supabase.co (IPv6 only; GitHub runners have no IPv6 as far as known).
# DIRECT_URL=


# ─── Auth (Clerk): REQUIRED in production ──────────────────────────────
# Use the PRODUCTION instance (pk_live_/sk_live_). Test keys are for Preview.
# The CSP is derived from the publishable key, so a rebuild is needed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Svix signing secret of the webhook <APP_URL>/api/webhooks/clerk (events user.*).
CLERK_WEBHOOK_SECRET=
# Alias of the same value, also accepted:
# CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/inloggen
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registreren
# Comma-separated e-mail addresses that become ADMIN. Only an address Clerk
# reports as VERIFIED can be promoted or claim an existing row. No admin exists
# until the first such sign-in; the alternative is
#   npx tsx scripts/make-admin.ts you@example.com        (uses DIRECT_URL, else DATABASE_URL)
ADMIN_EMAILS=


# ─── Company / fiscal identity: REQUIRED to take orders in production ──
# Printed on invoices and the legal pages. Checkout answers 503 (both payment
# paths) while any of the first seven AND COMPANY_EMAIL is missing, malformed or
# one of the old placeholder values. After changing any of them, REBUILD and
# redeploy: the legal pages are prerendered with the values of the build. Well-formed TEST numbers (KvK 90000001, NL900000010B01,
# NL02ABNA0123456789) pass that check on purpose, so CI can run a production
# build; `npm run preflight` refuses them for production. A factuur with an
# invented KvK or IBAN is not a valid invoice.
COMPANY_NAME=
COMPANY_STREET=
COMPANY_POSTAL_CODE=
COMPANY_CITY=
COMPANY_KVK=
COMPANY_VAT=
COMPANY_IBAN=
# REQUIRED. The one address customers see: contact, privacy, terms, withdrawal
# form, complaints, error messages and help articles all print this and nothing
# else (there is no built-in address). Reply-to of customer mail; also the
# default recipient of owner notifications.
COMPANY_EMAIL=
COMPANY_PHONE=


# ─── Owner notifications: at least ONE channel is required ─────────────
# New orders, payments, refunds, disputes, failures. Messages carry order
# number, total, item count and an admin link, never customer details.
# RESEND_API_KEY alone is NOT a channel: an e-mail needs an address too.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# E-mail channel: goes to ORDER_NOTIFY_EMAIL, else COMPANY_EMAIL (needs RESEND_API_KEY).
ORDER_NOTIFY_EMAIL=


# ─── E-mail (Resend): REQUIRED in production ───────────────────────────
# Bank-transfer customers get their payment instructions by mail, nothing else.
# The sending domain must be VERIFIED in Resend (SPF + DKIM DNS records).
RESEND_API_KEY=
RESEND_FROM_EMAIL="WasFix Pro <noreply@wasfix.nl>"
# Newsletter audience (contact list) in Resend. Confirmed sign-ups become contacts, opt-outs flag the contact
# unsubscribed; our NewsletterSubscriber table stays authoritative (DECISIONS.md D20). Optional: without it the
# list lives in our table only. Put OUR opt-out link in every broadcast (GET /api/newsletter/afmeldlinks, admin).
RESEND_AUDIENCE_ID=


# ─── Payments (Stripe): needed for card, iDEAL and subscriptions ───────
# Without STRIPE_SECRET_KEY only pay-by-bank-transfer works. iDEAL/card is offered
# only when BOTH STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set: with the key
# alone every payment would succeed at Stripe and stay PENDING here. If Stripe fails at
# checkout the customer stays on checkout (no silent fallback) and you are told.
# Live keys in production, test keys on Preview. `npm run preflight --
# --live-checks` verifies account, prices, webhook, Stripe Tax and portal.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook <APP_URL>/api/stripe/webhook (test and live differ).
STRIPE_WEBHOOK_SECRET=
# Recurring monthly EUR prices: Particulier 4,99 (tax inclusive), Monteur Pro 29
# and Bedrijf 199 (tax exclusive); see src/lib/plans.ts. All three are required.
STRIPE_PRICE_PARTICULIER=
STRIPE_PRICE_MONTEUR=
STRIPE_PRICE_BEDRIJF=


# ─── Scheduled jobs: REQUIRED in production ────────────────────────────
# Long random secret (openssl rand -hex 32). Vercel Cron sends it as
# "Authorization: Bearer <value>" to /api/cron/*. Unset = every job refuses to
# run (expiring unpaid orders, payment reminders, Stripe reconciliation, retention).
CRON_SECRET=


# ─── AI (Gemini) ───────────────────────────────────────────────────────
# Optional. Without a key the diagnosis runs on keywords and says so.
GEMINI_API_KEY=
# Alias of the same value, also accepted:
# GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# ─── Rate limiting (Upstash Redis) ─────────────────────────────────────
# Recommended. Without BOTH values the limits (e.g. 10 orders per hour per IP)
# are counted per server instance and restart at zero on a cold start, so on a
# serverless host the real limit is the limit times the number of instances.
# Monthly quotas kept in the database stay exact either way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─── Public API sandbox ────────────────────────────────────────────────
# Absent = no sandbox on a production build (the safe default). If set it must
# match wf_(live|test|demo)_<8-64 chars of A-Za-z0-9_> and only reads parts.
API_DEMO_KEY=


# ─── Feature flags (NEXT_PUBLIC_*, baked at build) ─────────────────────
# Referral programme: OFF unless exactly "true". Turning it on tells visitors
# they earn a reward and commits you to honour it: EUR 5 per referred customer's
# first PAID order, at most half of that order's margin (an order whose cost
# prices are not supplier quotes earns EUR 0) and at most EUR 500 per referrer
# per year (src/lib/referrals.ts). There is no automatic payout: you settle the
# credit by hand on request. It is off by default because of that.
NEXT_PUBLIC_FEATURE_REFERRAL=false
NEXT_PUBLIC_FEATURE_EXIT_INTENT=true
# No /de /fr /en routes exist yet; leave off.
NEXT_PUBLIC_FEATURE_I18N=false


# ─── Analytics (loaded only after the visitor consents) ────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_ID=
GA_MEASUREMENT_PROTOCOL_API_SECRET=
# Crisp chat: src/components/LiveChat.tsx reads this, but nothing mounts that component.
# NEXT_PUBLIC_CRISP_WEBSITE_ID=


# ─── Optional admin integrations ───────────────────────────────────────
# Search Console keyword sync for /admin/analytics (steps on /admin/analytics/connect-gsc).
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
# KvK lookup for monteur sign-up. Without it /api/monteur/kvk-lookup returns a mock company.
KVK_API_KEY=
