generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  clerkId          String?          @unique
  email            String           @unique
  name             String?
  role             String           @default("CONSUMER")
  plan             String           @default("FREE")
  stripeCustomerId String?
  stripeSubId      String?
  /// Stripe's own subscription status (trialing, active, past_due, canceled,
  /// unpaid, ...), mirrored by the webhook. User.plan alone cannot tell a
  /// paying customer from one whose card has failed for a month.
  stripeSubStatus  String?
  /// End of the period the customer has paid for. Access is honoured until
  /// then even after a cancellation.
  stripeCurrentPeriodEnd DateTime?
  /// True when the customer cancelled and the plan simply runs out at
  /// stripeCurrentPeriodEnd. Lets the dashboard say "loopt af op ..." instead of
  /// presenting a cancelled subscription as if it renewed.
  stripeCancelAtPeriodEnd Boolean @default(false)
  /// Set the first time this account starts a trial. A second trial on the
  /// same account (cancel and resubscribe) is refused when this is set.
  trialUsedAt      DateTime?
  diagnosesUsed    Int              @default(0)
  diagnosesResetAt DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  diagnoses        Diagnosis[]
  orders           Order[]
  savedMachines    SavedMachine[]
  apiKeys          ApiKey[]
  monteurProfile   MonteurProfile?
  monteurInvoices  MonteurInvoice[] @relation("MonteurInvoiceOwner")
  customers        Customer[]       @relation("CustomerOwner")
  workOrders       WorkOrder[]      @relation("WorkOrderOwner")
  referrals        Referral[]       @relation("ReferralReferrer")
  referralCode     String?          @unique

  @@index([role])
  @@index([plan])
}

model WashingMachine {
  id           String         @id @default(cuid())
  brand        String
  model        String
  yearFrom     Int?
  yearTo       Int?
  imageUrl     String?
  description  String?
  errorCodes   ErrorCode[]
  repairGuides RepairGuide[]
  parts        PartMachine[]
  saved        SavedMachine[]

  @@unique([brand, model])
  @@index([brand])
}

model SavedMachine {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineId String
  machine   WashingMachine @relation(fields: [machineId], references: [id])
  nickname  String?
  createdAt DateTime       @default(now())

  @@unique([userId, machineId])
}

model ErrorCode {
  id           String            @id @default(cuid())
  code         String
  machineId    String
  machine      WashingMachine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title        String
  description  String
  likelyCauses String
  severity     String            @default("MEDIUM")
  diyFriendly  Boolean           @default(true)
  /// Where this code's meaning comes from. A visitor deciding whether to open
  /// their machine deserves to know whether we checked, and against what.
  /// VERIFIED = confirmed against independent public sources;
  /// REPORTED = in circulation but we could not confirm it for this brand.
  provenance   String            @default("REPORTED")
  /// A real URL we checked the meaning against, when we have one.
  sourceUrl    String?
  /// Human-readable name of that source, for the citation line.
  sourceName   String?
  parts        ErrorCodeParts[]
  guides       ErrorCodeGuides[]

  @@unique([code, machineId])
  @@index([code])
  @@index([machineId])
  @@index([severity])
}

model RepairGuide {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  machineId   String?
  machine     WashingMachine?   @relation(fields: [machineId], references: [id])
  difficulty  String            @default("MEDIUM")
  timeMinutes Int
  steps       String
  tools       String
  summary     String
  warnings    String?
  isPremium   Boolean           @default(false)
  views       Int               @default(0)
  errorCodes  ErrorCodeGuides[]
  parts       GuideParts[]
  createdAt   DateTime          @default(now())

  @@index([machineId])
  @@index([difficulty])
  @@index([isPremium])
}

model Part {
  id          String           @id @default(cuid())
  sku         String           @unique
  name        String
  description String?
  brand       String
  category    String           @default("OTHER")
  priceEur    Float
  /// Wholesale/purchase price excluding VAT. Null = unknown, margin unreported.
  costEur     Float?
  /// Where costEur comes from: ESTIMATE (derived or guessed; scripts/add-part-costs.mjs
  /// derives it from the selling price) or QUOTE (a real supplier quote or
  /// invoice). Every margin figure counts QUOTE only and labels the rest
  /// "schatting".
  costSource  String           @default("ESTIMATE")
  stock       Int              @default(0)
  imageUrl    String?
  isOriginal  Boolean          @default(true)
  supplier    String?
  machines    PartMachine[]
  errorCodes  ErrorCodeParts[]
  guides      GuideParts[]
  orderItems  OrderItem[]

  @@index([brand])
  @@index([category])
}

model PartMachine {
  partId    String
  part      Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  machineId String
  machine   WashingMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@id([partId, machineId])
}

model ErrorCodeParts {
  errorCodeId String
  errorCode   ErrorCode @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([errorCodeId, partId])
}

model ErrorCodeGuides {
  errorCodeId String
  errorCode   ErrorCode   @relation(fields: [errorCodeId], references: [id], onDelete: Cascade)
  guideId     String
  guide       RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([errorCodeId, guideId])
}

model GuideParts {
  guideId String
  guide   RepairGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  partId  String
  part    Part        @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@id([guideId, partId])
}

model Diagnosis {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  brand     String
  model     String?
  symptoms  String
  messages  String
  result    String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  status          String      @default("PENDING")
  subtotalEur     Float
  discountEur     Float       @default(0)
  shippingEur     Float       @default(0)
  totalEur        Float
  /// VAT rate applied to this order (0.21 = 21%).
  vatRate         Float       @default(0.21)
  /// VAT contained in totalEur. Catalog prices are VAT-inclusive.
  vatEur          Float       @default(0)
  /// Buyer's VAT number when they ordered as a business.
  vatNumber       String?
  /// Sum of costEur * quantity at time of order; null when any cost is unknown.
  costEur         Float?
  stripePaymentId String?
  shippingAddress String
  email           String
  invoice         Invoice?
  /// STRIPE (card/iDEAL/Bancontact) or BANK_TRANSFER ("op rekening" — no
  /// Stripe keys required; the customer pays by wire against the invoice).
  paymentMethod   String      @default("STRIPE")
  /// Set for BANK_TRANSFER orders: when payment is due.
  dueAt           DateTime?
  /// When payment was actually confirmed (Stripe webhook, or an admin
  /// marking a bank-transfer order paid once the wire arrives).
  paidAt          DateTime?
  /// Set by markOrderShipped (src/lib/invoicing.ts).
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  /// POSTNL | DHL | DPD | UPS | GLS | OTHER (free text is tolerated).
  carrier         String?
  trackingCode    String?
  phone           String?
  customerNote    String?
  /// Money returned or owed back to the customer, in euro incl. VAT: the sum of
  /// the credit notes issued against this order while it was paid.
  refundedEur     Float       @default(0)
  /// Capability token for guest access: /bestelling/<id>?t=<token>. Random,
  /// never logged. Null only on rows that predate the column; the migration
  /// backfills every existing row.
  accessToken     String?     @unique
  /// Client-supplied key that makes a repeated checkout POST return the order
  /// it already created instead of a second one.
  idempotencyKey  String?     @unique
  /// The Stripe PaymentIntent behind the Checkout session (pi_...).
  /// stripePaymentId holds the session id (cs_...), which an API refund
  /// cannot use.
  stripePaymentIntentId String?
  rmaRequests     RmaRequest[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([stripePaymentId])
  @@index([stripePaymentIntentId])
  @@index([paymentMethod, status])
  @@index([email])
  /// The admin worklist: filter by status, newest first.
  @@index([status, createdAt])
}

/// Webhook idempotency as a LEASE, not a one-way flag. A row is created when a
/// delivery claims the event (claimedAt) and marked completedAt only after every
/// side effect succeeded. A function that dies after claiming leaves
/// completedAt NULL, so a later delivery can take the event over once the lease
/// (claimedAt older than a few minutes) has expired instead of answering
/// "already processed" for work that never finished.
model StripeEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  /// Kept from the original table: when the row was first written.
  processedAt   DateTime  @default(now())
  /// When the current holder took the lease. Refreshed on every takeover.
  claimedAt     DateTime  @default(now())
  /// NULL = not finished. Set once, after the handler succeeded.
  completedAt   DateTime?
  /// Number of times a handler has been started for this event.
  attempts      Int       @default(0)
  lastError     String?

  @@index([type])
  @@index([completedAt, claimedAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String
  part      Part   @relation(fields: [partId], references: [id])
  quantity  Int
  unitPrice Float
  /// Units of this line that refunds already put back on the shelf (goods that
  /// came back from a SHIPPED or DELIVERED order). The cap "ordered minus already
  /// restocked" is enforced on this column with a conditional update inside the
  /// refund's transaction (src/lib/invoicing.ts, applyRestock), so two refunds
  /// can never together put back more than was ordered. Cancelling is NOT
  /// counted here: it restocks every unit and ends the order. Credit notes
  /// issued before migration 20261009120000_order_item_restocked_qty carried
  /// this record on their linesJson; that migration backfilled the column from
  /// them and the annotation is never written since.
  restockedQty Int @default(0)

  /// Postgres does not index foreign keys automatically, and this table had no
  /// index at all beyond its primary key. Both columns are read on every order
  /// page, every invoice, every webhook and the delete-part guard.
  @@index([orderId])
  @@index([partId])
}

// ─── B2B API keys ────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  scopes     String    @default("read:parts,read:errorcodes,read:guides")
  rateLimit  Int       @default(1000)
  usageCount Int       @default(0)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── Reviews (moderated) ─────────────────────────────────────────
model Review {
  id         String   @id @default(cuid())
  targetType String // "part" | "guide"
  targetSku  String?
  targetSlug String?
  rating     Int
  title      String
  body       String
  author     String
  email      String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  /// True only when this e-mail has a PAID order containing the reviewed part.
  /// Drives the "geverifieerde aankoop" badge, so it is never set by hand.
  verifiedPurchase Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([targetType, targetSku])
  @@index([targetType, targetSlug])
  @@index([status])
}

// ─── Returns (RMA) ───────────────────────────────────────────────
model RmaRequest {
  id        String   @id @default(cuid())
  rmaNumber String   @unique
  /// What the customer typed in the return form, verbatim. Free text: the form
  /// accepts any 2-60 characters and customers type the short reference shown
  /// on /bestelling, so this is NOT a foreign key (a foreign key here made
  /// /api/retour fail with P2003 on every such reference).
  orderId   String
  /// The order this return belongs to, once someone (or the backfill in the
  /// migration) has matched the text above to a real order. Null until then.
  linkedOrderId String?
  order     Order?   @relation(fields: [linkedOrderId], references: [id], onDelete: SetNull)
  name      String
  email     String
  reason    String
  notes     String
  status    String   @default("RECEIVED") // RECEIVED | APPROVED | REJECTED | REFUNDED
  /// When the request was settled (refunded or rejected).
  resolvedAt DateTime?
  /// Amount refunded for this return, incl. VAT.
  refundEur Float?
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([orderId])
  @@index([linkedOrderId])
}

// ─── Monteur Pro applications ────────────────────────────────────
model MonteurApplication {
  id              String   @id @default(cuid())
  applicationId   String   @unique
  companyName     String
  kvkNumber       String
  vatNumber       String?
  email           String
  phone           String?
  contactName     String
  yearsExperience Int?
  coverageAreas   String?
  specializations String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([status])
}

// ─── Newsletter / lead magnets ───────────────────────────────────
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// ─── AI quality loop ─────────────────────────────────────────────
model DiagnosisFeedback {
  id          String   @id @default(cuid())
  diagnosisId String?
  sessionId   String?
  rating      String // "up" | "down"
  comment     String?
  createdAt   DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
}

// ─── Monteur CRM: klanten en werkorders ──────────────────────────
model Customer {
  id         String      @id @default(cuid())
  ownerId    String
  owner      User        @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  street     String?
  postalCode String?
  city       String?
  machine    String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workOrders WorkOrder[]

  @@index([ownerId])
  @@index([ownerId, name])
}

// ─── Monteur invoicing ───────────────────────────────────────────
// A monteur invoices their own customer, so they are the seller here — not
// WasFix. Their business identity and their own gapless invoice series live
// separately from ours.
model MonteurProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  contactName   String?
  kvkNumber     String?
  vatNumber     String?
  street        String?
  postalCode    String?
  city          String?
  iban          String?
  email         String?
  phone         String?
  /// Most one-person repair businesses charge the standard 21% rate.
  vatRate       Float    @default(0.21)
  hourlyRateEur Float?
  paymentTerms  Int      @default(14)
  invoiceFooter String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MonteurInvoice {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation("MonteurInvoiceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workOrderId String    @unique
  /// Restrict, not Cascade: deleting a work order used to delete the invoice
  /// issued from it while leaving MonteurInvoiceSequence advanced — a
  /// permanent hole in a series the Belastingdienst requires to be gapless,
  /// and a sent invoice vanishing from the books. deleteWorkOrder() refuses
  /// when an invoice exists.
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  number      String
  year        Int
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  subtotalEur Float
  vatRate     Float
  vatEur      Float
  totalEur    Float
  sellerJson  String
  buyerJson   String
  linesJson   String

  @@unique([ownerId, number])
  @@index([ownerId, year])
}

// Per-monteur, per-year counter so each monteur has their own unbroken series.
model MonteurInvoiceSequence {
  ownerId String
  year    Int
  last    Int    @default(0)

  @@id([ownerId, year])
}

model WorkOrder {
  id          String          @id @default(cuid())
  ownerId     String
  owner       User            @relation("WorkOrderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reference   String
  machine     String?
  errorCode   String?
  problem     String
  status      String          @default("OPEN") // OPEN | GEPLAND | WACHT_OP_ONDERDEEL | VOLTOOID | GEANNULEERD
  urgent      Boolean         @default(false)
  scheduledAt DateTime?
  priceEur    Float?
  notes       String?
  invoice     MonteurInvoice?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([ownerId, reference])
  @@index([ownerId, status])
  @@index([customerId])
}

// ─── Referrals ───────────────────────────────────────────────────
model Referral {
  id          String    @id @default(cuid())
  code        String
  referrerId  String?
  referrer    User?     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  visitorId   String
  landingPath String?
  signedUpAt  DateTime?
  convertedAt DateTime?
  rewardEur   Float     @default(0)
  createdAt   DateTime  @default(now())

  @@unique([code, visitorId])
  @@index([code])
  @@index([referrerId])
  /// recordSignup/recordConversion filter on visitorId alone, which cannot use
  /// the (code, visitorId) unique index — it was a sequential scan on every
  /// checkout.
  @@index([visitorId])
}

// ─── Invoices ────────────────────────────────────────────────────
// NL law requires a sequential, gapless invoice number and a VAT
// specification per order, retained for 7 years. Seller and buyer details are
// snapshotted so a later change of address never rewrites history.
model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  year        Int
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  issuedAt    DateTime @default(now())
  subtotalEur Float
  discountEur Float    @default(0)
  shippingEur Float    @default(0)
  vatRate     Float
  vatEur      Float
  totalEur    Float
  sellerJson  String
  buyerJson   String
  linesJson   String
  creditNotes CreditNote[]

  @@index([year])
  @@index([issuedAt])
}

// Allocates gapless invoice numbers per year under a transaction.
model InvoiceSequence {
  year Int @id
  last Int @default(0)
}

// ─── Credit notes (creditfacturen) ───────────────────────────────
// An issued invoice is never edited or deleted. A cancellation or refund of an
// invoiced order is booked as a credit note from its own gapless series
// (CN-YYYY-NNNNN, Europe/Amsterdam year), written in the same transaction as
// the state change.
//
// SIGN CONVENTION: every amount here is a POSITIVE magnitude (the amount that
// is credited). The printed document shows it with a minus sign. In the ledger
// a credit note counts negative:
//   revenue incl. VAT = sum(Invoice.totalEur) - sum(CreditNote.totalEur)
//   VAT payable       = sum(Invoice.vatEur)   - sum(CreditNote.vatEur)
// subtotalEur is the credited amount EXCLUDING VAT (totalEur - vatEur), unlike
// Invoice.subtotalEur which is the gross goods value before discount.
model CreditNote {
  id             String   @id @default(cuid())
  /// "CN-2026-00001"
  number         String   @unique
  year           Int
  issuedAt       DateTime @default(now())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reason         String
  subtotalEur    Float
  vatRate        Float
  vatEur         Float
  totalEur       Float
  sellerJson     String
  buyerJson      String
  linesJson      String
  /// Stripe refund (re_...) that paid this credit out, when there is one.
  /// Unique, so replaying a refund webhook cannot create a second credit note.
  stripeRefundId String?  @unique
  /// Caller-supplied key that makes a refund without a Stripe id (bank
  /// transfer) idempotent: the same key returns the same note. Unique.
  idempotencyKey String?  @unique

  @@index([invoiceId])
  @@index([year])
}

// Gapless credit-note numbers per year, allocated like InvoiceSequence.
model CreditNoteSequence {
  year Int @id
  last Int @default(0)
}

// ─── Metered free usage ──────────────────────────────────────────
// Enforces the free tier for visitors who are not signed in, so the paid
// plans mean something. Keyed on a hash of the visitor cookie or IP.
model UsageCounter {
  id        String   @id @default(cuid())
  scope     String
  key       String
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([windowEnd])
}
