# ─── Core ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://wasfix.nl
DEMO_MODE=true
NODE_ENV=development

# ─── Database (Supabase Postgres) ──────────────────────────────
DATABASE_URL=

# ─── Auth (Clerk) ──────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/inloggen
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registreren

# ─── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Payments (Stripe) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PARTICULIER=
STRIPE_PRICE_MONTEUR=
STRIPE_PRICE_BEDRIJF=
STRIPE_PRICE_ENTERPRISE=

# ─── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="WasFix Pro <noreply@wasfix.nl>"
RESEND_AUDIENCE_ID=

# ─── Analytics ─────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_ID=
GA_MEASUREMENT_PROTOCOL_API_SECRET=

# ─── Error monitoring (Sentry) ─────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=wasfix-pro

# ─── Rate limiting (Upstash Redis) ─────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Search Console (for /admin/analytics keyword sync) ────────
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# ─── Notifications ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ─── KvK API (NL business verification for Monteur Pro) ────────
KVK_API_KEY=

# ─── FX rates (multi-currency) ─────────────────────────────────
EXCHANGERATE_API_KEY=

# ─── Live chat (Crisp.chat) ────────────────────────────────────
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ─── Feature flags ─────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_I18N=false
NEXT_PUBLIC_FEATURE_REFERRAL=false
NEXT_PUBLIC_FEATURE_EXIT_INTENT=true
NEXT_PUBLIC_FEATURE_CHAT_WIDGET=false
